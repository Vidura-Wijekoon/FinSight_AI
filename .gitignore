# Keys & secrets — NEVER commit these
keys/
.env

# Document data — encrypted binaries and ingestion metadata records.
# Both directories are created at runtime (src/api/main.py, FileHandler), so
# neither needs to be committed. The metadata records contain original file
# names, uploader identity and timestamps, which do not belong in a public repo.
data/uploads/
data/processed/

