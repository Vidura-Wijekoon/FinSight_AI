# ============================================================
# FinSight AI — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Security ---
SECRET_KEY=your-super-secret-64-char-hex-key-change-this-immediately
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Admin Credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# --- Deployment mode ---
# sovereign: refuses to start with any non-local LLM provider. This is the
#            guarantee the whole design exists to provide — leave it alone
#            unless you intend document content to leave the host.
# hybrid:    permits a remote provider, and accepts that consequence.
DEPLOYMENT_MODE=sovereign

# --- LLM (local-first: Ollama + qwen2.5, no external API needed) ---
LLM_PROVIDER=ollama
GEMINI_API_KEY=                     # only needed if LLM_PROVIDER=gemini,
                                    # which also requires DEPLOYMENT_MODE=hybrid
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# --- Embedding (fully local, no API key needed) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=finsight_docs

# --- File Paths ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
LOG_FILE=./logs/rag_audit.log
ENCRYPTION_KEY_PATH=./keys/secret.key

# --- Ingestion Limits ---
MAX_FILE_SIZE_MB=50

# --- Rate limiting (per authenticated user; counters are per process) ---
RATE_LIMIT_QUERY=30/minute
RATE_LIMIT_INGEST=10/minute
